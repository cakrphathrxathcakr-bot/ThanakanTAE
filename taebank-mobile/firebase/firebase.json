{
  "functions": [
    {
      "source": "functions",
      "codebase": "taebank",
      "runtime": "nodejs22",
      "ignore": ["node_modules", ".git", "firebase-debug.log", "firebase-debug.*.log"]
    }
  ],
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "public": "..",
    "ignore": ["firebase/**", "tests/**", "package*.json", "**/.*", "**/node_modules/**", "*.md", "*.zip"],
    "headers": [
      {"source": "**", "headers": [{"key": "X-Content-Type-Options", "value": "nosniff"}, {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"}]},
      {"source": "firebase-config.js", "headers": [{"key": "Cache-Control", "value": "no-cache"}]}
    ]
  },
  "emulators": {
    "auth": {"port": 9099},
    "functions": {"port": 5001},
    "database": {"port": 9000},
    "hosting": {"port": 5000},
    "ui": {"enabled": true}
  }
}
